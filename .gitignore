# Grabaciones de ROS 2 (bags) — no se suben a git
bags/*
!bags/.gitkeep

# Mapas pesados
*.pcd
*.ply
*.bag
*.mcap
*.db3
!mapas/ejemplos/*.pcd

# Builds de ROS 2 / colcon
build/
install/
log/

# Python
__pycache__/
*.pyc
.venv/

# Sistema y editores
.DS_Store
*.swp
.vscode/
.idea/
mapas/**/*.log

# Mundos de Gazebo de mapas reales: se regeneran con scripts/simulacion/generar_mundo_gazebo.py
mapas/20*/gazebo/
# Registros de lanzamiento de las pruebas (pueden ser grandes)
resultados/**/launch.log
